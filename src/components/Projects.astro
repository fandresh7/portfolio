---
import type { SiteContent } from '../data/content';
import { techIcons } from '../data/techIcons';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<div id="proyectos">
  <h2 data-i18n="projects.heading" class="text-2xl font-semibold tracking-tight text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">
    {content.projects.heading}
  </h2>
  <p data-i18n="projects.subheading" class="mt-2 max-w-xl text-[var(--color-ink-soft)] dark:text-[var(--color-dark-ink-soft)]">
    {content.projects.subheading}
  </p>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    {content.projects.items.map((project) => (
      <article class={`relative rounded-2xl border bg-[var(--color-surface)] p-5 transition-colors dark:bg-[var(--color-dark-surface)] ${project.company ? 'border-[var(--color-accent)]/30 hover:border-[var(--color-accent)] dark:border-[var(--color-dark-accent)]/30 dark:hover:border-[var(--color-dark-accent)]' : 'border-[var(--color-border)] hover:border-[var(--color-accent)]/50 dark:border-[var(--color-dark-border)] dark:hover:border-[var(--color-dark-accent)]/50'} ${project.featured ? 'sm:col-span-2' : ''}`}>
        {project.company && (
          <span class="mb-3 flex w-fit items-center gap-1.5 rounded-full bg-[var(--color-accent)]/10 px-2.5 py-1 text-[11px] font-medium text-[var(--color-accent)] dark:bg-[var(--color-dark-accent)]/15 dark:text-[var(--color-dark-accent)]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-3 w-3">
              <rect x="3" y="7" width="18" height="13" rx="2" />
              <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke-linecap="round" />
            </svg>
            {project.company}
          </span>
        )}
        <h3 data-i18n={`projects.items.${project.id}.name`} class="text-base font-semibold text-[var(--color-ink)] dark:text-[var(--color-dark-ink)]">
          {project.name}
        </h3>
        <p data-i18n={`projects.items.${project.id}.description`} class="mt-2 text-[15px] leading-relaxed text-[var(--color-ink-soft)] dark:text-[var(--color-dark-ink-soft)]">
          {project.description}
        </p>

        <div class="mt-4 flex flex-wrap gap-2">
          {project.tags.map((tag) => {
            const icon = techIcons[tag];
            return (
              <span class="inline-flex items-center gap-1.5 rounded-full bg-[var(--color-bg-soft)] py-1 pl-1 pr-2.5 text-xs text-[var(--color-ink-soft)] dark:bg-[var(--color-dark-bg)] dark:text-[var(--color-dark-ink-soft)]">
                {icon && (
                  <span
                    class="flex h-4 w-4 shrink-0 items-center justify-center rounded text-[11px] font-bold leading-none"
                    style={`background-color:${icon.bg}; color:${icon.fg}`}
                  >
                    {icon.label}
                  </span>
                )}
                {tag}
              </span>
            );
          })}
        </div>

        {(project.github || project.demo || project.npm) && (
          <div class="mt-4 flex gap-4 text-sm">
            {project.github && (
              <a href={project.github} target="_blank" rel="noopener noreferrer" class="font-medium text-[var(--color-accent)] hover:underline dark:text-[var(--color-dark-accent)]">
                GitHub &rarr;
              </a>
            )}
            {project.demo && (
              <a href={project.demo} target="_blank" rel="noopener noreferrer" class="font-medium text-[var(--color-accent)] hover:underline dark:text-[var(--color-dark-accent)]">
                Demo &rarr;
              </a>
            )}
            {project.npm && (
              <a href={project.npm} target="_blank" rel="noopener noreferrer" class="font-medium text-[var(--color-accent)] hover:underline dark:text-[var(--color-dark-accent)]">
                npm &rarr;
              </a>
            )}
          </div>
        )}
      </article>
    ))}
  </div>
</div>
