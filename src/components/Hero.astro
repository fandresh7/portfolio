---
import type { SiteContent } from '../data/content';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section id="inicio" class="mx-auto max-w-5xl px-6 pt-16 pb-12 sm:pt-24 sm:pb-16">
  <div class="flex h-16 w-16 items-center justify-center rounded-full bg-[var(--color-bg-soft)] text-lg font-semibold text-[var(--color-ink-soft)] dark:bg-[var(--color-dark-surface)] dark:text-[var(--color-dark-ink-soft)]">
    AH
  </div>

  <p data-i18n="hero.kicker" class="mt-8 text-sm font-medium uppercase tracking-widest text-[var(--color-accent)] dark:text-[var(--color-dark-accent)]">
    {content.hero.kicker}
  </p>

  <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-5xl dark:text-[var(--color-dark-ink)]">
    <span data-i18n="hero.name">{content.hero.name}</span>
    <span data-i18n="hero.title" class="block text-[var(--color-ink-soft)] dark:text-[var(--color-dark-ink-soft)]">{content.hero.title}</span>
  </h1>

  <p data-i18n="hero.bio" class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-soft)] dark:text-[var(--color-dark-ink-soft)]">
    {content.hero.bio}
  </p>

  <div class="mt-8 flex items-center gap-4">
    <a
      href={content.social.github}
      target="_blank"
      rel="noopener noreferrer"
      class="flex h-10 w-10 items-center justify-center rounded-full border border-[var(--color-border)] text-[var(--color-ink-soft)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] dark:border-[var(--color-dark-border)] dark:text-[var(--color-dark-ink-soft)] dark:hover:border-[var(--color-dark-accent)] dark:hover:text-[var(--color-dark-accent)]"
      aria-label="GitHub"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.833.092-.647.35-1.088.636-1.339-2.221-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.026 2.747-1.026.546 1.378.203 2.397.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"/>
      </svg>
    </a>
    <a
      href={content.social.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="flex h-10 w-10 items-center justify-center rounded-full border border-[var(--color-border)] text-[var(--color-ink-soft)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] dark:border-[var(--color-dark-border)] dark:text-[var(--color-dark-ink-soft)] dark:hover:border-[var(--color-dark-accent)] dark:hover:text-[var(--color-dark-accent)]"
      aria-label="LinkedIn"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
        <path d="M6.94 5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0ZM3.28 8.75h3.72V21H3.28V8.75Zm6.6 0h3.57v1.68h.05c.5-.93 1.7-1.9 3.5-1.9 3.74 0 4.43 2.37 4.43 5.46V21h-3.72v-5.36c0-1.28-.02-2.92-1.8-2.92-1.8 0-2.08 1.38-2.08 2.82V21H9.88V8.75Z"/>
      </svg>
    </a>
  </div>
</section>
